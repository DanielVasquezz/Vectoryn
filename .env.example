# ==============================================================
# Vectoryn — Environment Variables
# ==============================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git (it is already in .gitignore)
#
# Why environment variables?
# The same code runs in local, staging, and production
# without modifications — only the variables change.
# This is Principle #3 of the "12-Factor App" methodology
# adopted by Netflix, Heroku, and virtually every 
# modern cloud-native company.
# ==============================================================

# This file contains ONLY placeholders (no secrets)
# ==============================================================


# ── Kafka / Aiven (Cloud) ─────────────────────────────────────
# Example: your-cluster.aivencloud.com:21404
KAFKA_BOOTSTRAP_SERVERS=your_kafka_host:port
KAFKA_SASL_USERNAME=your_kafka_username
KAFKA_SASL_PASSWORD=your_kafka_password
KAFKA_TOPIC_INGEST=raw-documents


# ── Qdrant Vector Database (Cloud) ────────────────────────────
# Example: https://your-cluster.qdrant.io
QDRANT_URL=https://your-qdrant-cluster-url
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=documents


# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ── LLM (Groq API) ───────────────────────────────────────────
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant


# ── CORS / Security ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# Internal API Key (must be the SAME across all services)
VECTORYN_API_KEY=your_secret_key_here


# ── Redis (Upstash) ───────────────────────────────────────────
# Must use rediss:// (TLS enabled)
# Example:
# rediss://default:token@your-db.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_token@your-upstash-host:6379


# ── OpenTelemetry / Jaeger (Distributed Tracing) ─────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vectoryn