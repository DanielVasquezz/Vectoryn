# ==============================================================
# Vectoryn — Environment Variables
# ==============================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env to Git (it is already in .gitignore)
#
# Why environment variables?
# The same code runs in local, staging, and production
# without modifications — only the variables change.
# This is Principle #3 of the "12-Factor App" methodology
# adopted by Netflix, Heroku, and virtually every 
# modern cloud-native company.
# ==============================================================

# ── Kafka / Redpanda ──────────────────────────────────────────
# In local development, Redpanda runs at localhost:9092
# In Docker Compose, the hostname is the service name: "redpanda:9092"
# In Kubernetes, it would be: "kafka-headless.kafka.svc.cluster.local:9092"
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INGEST=raw-documents

# ── Qdrant Vector Database ────────────────────────────────────
# In Docker Compose, the hostname is "qdrant:6333"
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Embedding Model ───────────────────────────────────────────
# MiniLM-L6-v2: Lightweight model (80MB), 384 dimensions, excellent for RAG
# More powerful alternatives (but slower/larger):
#   - sentence-transformers/all-mpnet-base-v2 (768 dim, better quality)
#   - BAAI/bge-large-en-v1.5 (1024 dim, state-of-the-art)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM (Groq API) ───────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Available models on Groq (approximate inference speeds):
#   - llama-3.1-8b-instant   → ~1200 tokens/sec (fast, good for RAG)
#   - llama-3.3-70b-versatile → ~400 tokens/sec (higher quality)
#   - mixtral-8x7b-32768     → ~500 tokens/sec (good long context)
GROQ_MODEL=llama-3.1-8b-instant

# ── CORS / Security ──────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# API Key for production access (Security Layer)
VECTORYN_API_KEY=your_secret_key_here

# ── Redis (Cache + Rate Limiting) ────────────────────────────
# In Docker Compose, the hostname is "redis"
# In production: Redis Cloud, AWS ElastiCache, etc.
REDIS_URL=redis://localhost:6379

# ── OpenTelemetry / Jaeger (Distributed Tracing) ─────────────
# In Docker Compose, the hostname is "jaeger"
# OTLP = OpenTelemetry Protocol (CNCF standard)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vectoryn